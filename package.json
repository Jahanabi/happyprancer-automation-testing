    "framer-motion": "^12.5.0",
    "gsap": "^3.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.437.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^3.1.0",
    "quill-image-resize-module-react": "^3.0.0",
