{
  "name": "code-generator",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "yarn && react-scripts start",
    "dev": "react-scripts start",
    "build": "cross-env GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:report": "playwright show-report",
    "test:diff": "node automation/dist/automation/scripts/analyze-diff.js",
    "test:generate-cases": "node automation/dist/automation/scripts/generate-test-cases.js",
    "test:generate-scripts": "node automation/dist/automation/scripts/generate-playwright.js",
    "test:validate": "node automation/dist/automation/scripts/validate-generated-tests.js",
    "test:export-excel": "node automation/dist/automation/scripts/export-excel-report.js",
    "test:automation": "tsc --project tsconfig.automation.json && node automation/dist/automation/scripts/generate-test-cases.js && node automation/dist/automation/scripts/generate-playwright.js && node automation/dist/automation/scripts/validate-generated-tests.js && node automation/dist/automation/scripts/export-excel-report.js",
    "mcp:playwright": "npx -y @modelcontextprotocol/server-playwright",
    "eject": "react-scripts eject",
    "start:prod": "yarn build && yarn serve"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
