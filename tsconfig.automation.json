{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./automation/dist",
    "rootDir": "./",
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "automation/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "src"
  ]
}
