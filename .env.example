# ==============================================================================
# HAPPY PRANCER PLAYWRIGHT AUTOMATION ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure local values before running tests.
# DO NOT commit real passwords, tokens, or secret keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & ENVIRONMENT URLS
# ------------------------------------------------------------------------------
# Base URL of Happy Prancer application under test
BASE_URL=https://beta.happyprancer.com

# URL of the registration page used in SIGNUP-001 through SIGNUP-022
SIGNUP_URL=https://beta.happyprancer.com/signup

# Protected dashboard URL used in LOGIN-020 to verify session-guard redirects
AUTH_TEST_DASHBOARD_URL=https://beta.happyprancer.com/dashboard

# Target Git branch for PR diff analysis and test generation
TARGET_BRANCH=test-workflow

# ------------------------------------------------------------------------------
# 2. GEMINI AI TEST GENERATION CONFIGURATION
# ------------------------------------------------------------------------------
# AI Provider: 'gemini' (uses Google Gemini API) or 'offline' (deterministic code heuristic)
AI_PROVIDER=gemini

# Google Gemini API key (Secret in GitHub Actions: GEMINI_API_KEY)
GEMINI_API_KEY=

# Gemini model identifier (e.g. gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
AI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. LOGIN AUTHENTICATION CREDENTIALS
# Used in LOGIN-015 (Live end-to-end authentication and dashboard navigation)
# ------------------------------------------------------------------------------
# Verified Happy Prancer test account email (GitHub Secret: LOGIN_EMAIL)
LOGIN_EMAIL=qa-testuser@happyprancer.com

# Verified Happy Prancer test account password (GitHub Secret: LOGIN_PASSWORD)
LOGIN_PASSWORD=YourSecureTestPassword!123

# ------------------------------------------------------------------------------
# 4. SIGNUP TEST DATA (SIGNUP-001 through SIGNUP-022)
# ------------------------------------------------------------------------------
# Full Name for user registration fields (SIGNUP-002, SIGNUP-015)
SIGNUP_NAME=Test User

# Base email for user registration (SIGNUP-015 dynamically suffixes timestamp)
SIGNUP_EMAIL=automation-qa@example.com

# 10-digit phone number for registration input (SIGNUP-006, SIGNUP-015)
SIGNUP_PHONE=9876543210

# Valid compliant password meeting length, uppercase, lowercase, numeric, and symbol rules
SIGNUP_PASSWORD=Test@1234

# Matching confirmation password (SIGNUP-012, SIGNUP-013, SIGNUP-015)
SIGNUP_CONFIRM_PASSWORD=Test@1234

# Optional referral code to verify referral pre-population (SIGNUP-014, SIGNUP-015)
SIGNUP_REFERRAL_CODE=HPWELCOME

